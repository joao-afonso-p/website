---
import { alfredoCapabilities } from '../../config/alfredo';
import { url } from '../../lib/paths';

/**
 * The Alfredo capability record: an index table where each row expands in
 * place. Same editorial table language as the rest of the site, on Alfredo's
 * own surface.
 *
 * Interaction: native <button> per row with a correctly maintained
 * `aria-expanded`, one row open at a time. That combination cannot be done in
 * CSS alone, so this is the only page on the site that ships any JavaScript —
 * about 600 bytes, and only here.
 *
 * It degrades cleanly: the first ready capability is marked active in the HTML,
 * so with JavaScript disabled the page still renders a complete, readable
 * record instead of six collapsed rows.
 */

/** Open by default: the first capability that actually exists. */
const defaultOpen =
  alfredoCapabilities.find((capability) => !capability.planned)?.number ??
  alfredoCapabilities[0]?.number;
---

<div class="alfredo-section-header" aria-hidden="true">
  <span>No.</span>
  <span>Capability</span>
  <span>Status</span>
</div>

<section aria-label="Alfredo capabilities">
  {alfredoCapabilities.map((capability) => {
    const active = capability.number === defaultOpen;
    const panelId = `alfredo-capability-${capability.number}`;
    const hasDetail = Boolean(
      capability.label || capability.whatItDoes || capability.whatILearned || capability.noteHref,
    );

    return (
      <article
        class="alfredo-capability"
        data-alfredo-capability
        data-active={String(active)}
        data-planned={String(capability.planned)}
      >
        <button
          class="alfredo-capability-button"
          type="button"
          aria-expanded={active}
          aria-controls={panelId}
        >
          <span class="alfredo-capability-number">{capability.number}</span>

          <span class="alfredo-capability-title">{capability.title}</span>

          <span class="alfredo-capability-status">{capability.status}</span>
        </button>

        {hasDetail && (
          <div class="alfredo-capability-detail" id={panelId}>
            <div class="alfredo-detail-label">{capability.label}</div>

            {capability.whatItDoes && (
              <p>
                <span>What it does</span>
                {capability.whatItDoes}
              </p>
            )}

            {capability.whatILearned && (
              <p>
                <span>What I learned</span>
                {capability.whatILearned}
              </p>
            )}

            {capability.noteHref && (
              <a class="alfredo-link" href={url(capability.noteHref)}>
                Read note <span aria-hidden="true">&#8599;</span>
              </a>
            )}
          </div>
        )}
      </article>
    );
  })}
</section>

<style>
  /* Geometry and type scale are Alfredo's own, and tighter than the site's.
     Colours come from the --color-alfredo-* tokens in global.css. */

  .alfredo-section-header,
  .alfredo-capability-button {
    display: grid;
    grid-template-columns: 72px 1fr 130px;
  }

  .alfredo-section-header {
    padding: 10px 0;
    border-top: 1px solid var(--color-alfredo-text);
    color: var(--color-alfredo-muted);
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
  }

  .alfredo-section-header span:last-child {
    text-align: right;
  }

  .alfredo-capability {
    border-top: 1px solid var(--color-alfredo-line);
  }

  .alfredo-capability:last-child {
    border-bottom: 1px solid var(--color-alfredo-text);
  }

  .alfredo-capability-button {
    align-items: center;
    width: 100%;
    padding: 19px 0 18px;
    border: 0;
    background: transparent;
    color: var(--color-alfredo-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .alfredo-capability-number {
    color: var(--color-alfredo-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .alfredo-capability-title {
    font-size: clamp(24px, 4vw, 46px);
    line-height: 1;
    letter-spacing: -0.055em;
    transition:
      color 150ms ease,
      transform 200ms ease;
  }

  .alfredo-capability-status {
    color: var(--color-alfredo-text);
    font-family: var(--font-mono);
    font-size: 9px;
    text-align: right;
    text-transform: uppercase;
  }

  .alfredo-capability-status::before {
    content: '\25CF';
    margin-right: 7px;
    color: var(--color-alfredo-blue);
  }

  .alfredo-capability[data-planned='true'] .alfredo-capability-status::before {
    content: '\25CB';
    color: var(--color-alfredo-muted);
  }

  .alfredo-capability[data-planned='true'] .alfredo-capability-title {
    color: var(--color-alfredo-muted);
  }

  .alfredo-capability-button:hover .alfredo-capability-title {
    color: var(--color-alfredo-blue);
    transform: translateX(6px);
  }

  .alfredo-capability[data-active='true'] {
    background: var(--color-alfredo-blue-wash);
  }

  .alfredo-capability[data-active='true'] .alfredo-capability-button {
    padding-right: 16px;
    padding-left: 16px;
  }

  .alfredo-capability[data-active='true'] .alfredo-capability-number,
  .alfredo-capability[data-active='true'] .alfredo-capability-title {
    color: var(--color-alfredo-blue);
  }

  .alfredo-capability-detail {
    display: grid;
    grid-template-columns: 72px 1fr 1fr 130px;
    gap: 28px;
    padding: 2px 16px 28px;
  }

  .alfredo-capability[data-active='false'] .alfredo-capability-detail {
    display: none;
  }

  .alfredo-detail-label {
    color: var(--color-alfredo-blue);
    font-family: var(--font-mono);
    font-size: 8px;
    text-transform: uppercase;
  }

  .alfredo-capability-detail p {
    margin: 0;
    color: var(--color-alfredo-text);
    font-size: 12px;
    line-height: 1.6;
  }

  .alfredo-capability-detail p span {
    display: block;
    margin-bottom: 7px;
    color: var(--color-alfredo-muted);
    font-family: var(--font-mono);
    font-size: 8px;
    text-transform: uppercase;
  }

  .alfredo-link {
    align-self: start;
    justify-self: end;
    border-bottom: 1px solid var(--color-alfredo-blue);
    color: var(--color-alfredo-blue);
    font-family: var(--font-mono);
    font-size: 8px;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .alfredo-section-header,
    .alfredo-capability-button {
      grid-template-columns: 44px 1fr 88px;
    }

    .alfredo-capability-detail {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 4px 16px 24px 60px;
    }

    .alfredo-detail-label {
      display: none;
    }

    .alfredo-link {
      justify-self: start;
    }
  }
</style>

<script>
  // One row open at a time, with `aria-expanded` kept truthful. Clicking the
  // open row closes it.
  const rows = document.querySelectorAll<HTMLElement>('[data-alfredo-capability]');

  for (const row of rows) {
    const button = row.querySelector('button');
    if (!button) continue;

    button.addEventListener('click', () => {
      const shouldOpen = row.dataset.active !== 'true';

      for (const other of rows) {
        other.dataset.active = 'false';
        other.querySelector('button')?.setAttribute('aria-expanded', 'false');
      }

      if (shouldOpen) {
        row.dataset.active = 'true';
        button.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>
