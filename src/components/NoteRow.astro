---
import { url } from '../lib/paths';

/**
 * A note in a list: mono date left, title and description right.
 *
 * Desktop (>=768px) is a 12-column table:
 *   DATE (1-2) | title + description (3-8) | status / series / tags (9-11) | arrow (12)
 * Mobile reorganises rather than shrinks: date and status collapse into one
 * compact mono row above the title (`md:contents` dissolves that wrapper on
 * desktop), then the title, then the description, then the tags.
 *
 * Render rows as direct siblings so `last:border-b` closes the list.
 */
interface Props {
  title: string;
  date?: Date;
  description?: string;
  tags?: string[];
  series?: string;
  /** Free-form note status, e.g. `Field note`. */
  status?: string;
  /** App-relative internal path, e.g. `/notes/my-note`. Resolved via `url()` here. */
  href: string;
}

const { title, date, description, tags = [], series, status, href } = Astro.props;

/**
 * Matches `formatDate()` in src/lib/content.ts ('12 Mar 2026'). Formatted here
 * so this component stays independent of the data layer.
 */
const DATE_FORMAT = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  // UTC, so `date: 2026-03-12` never renders as the 11th west of Greenwich —
  // which would also contradict the `datetime` attribute below.
  timeZone: 'UTC',
});

const dateLabel = date ? DATE_FORMAT.format(date) : undefined;
const dateTime = date ? date.toISOString().slice(0, 10) : undefined;

const joined = (parts: Array<string | undefined>): string =>
  parts.filter((part): part is string => Boolean(part)).join(' · ');

const tagText = tags.length > 0 ? tags.join(' · ') : undefined;
/** Mobile shows status in the top row already, so it is dropped from the tail. */
const tailMobile = joined([series, tagText]);
const tailDesktop = joined([status, series, tagText]);
---

<div class="border-t border-rule last:border-b">
  <a
    href={url(href)}
    class="group grid grid-cols-1 gap-x-6 gap-y-2 py-5 transition-colors hover:bg-paper-sunk md:grid-cols-12 md:items-baseline md:gap-y-0 md:py-6"
  >
    {/* Mobile: date + status + arrow on one mono row. Desktop: date and arrow cells. */}
    <div class="flex items-baseline gap-4 md:contents">
      {dateLabel && dateTime ? (
        <time
          datetime={dateTime}
          class="meta tabular-nums md:col-span-2 md:col-start-1 md:row-start-1"
        >
          {dateLabel}
        </time>
      ) : (
        <span
          class="meta text-muted md:col-span-2 md:col-start-1 md:row-start-1"
          aria-hidden="true"
        >
          &#8212;
        </span>
      )}

      {status && <span class="meta text-muted md:hidden">{status}</span>}

      <span
        class="arrow meta text-muted ml-auto md:col-span-1 md:col-start-12 md:row-start-1 md:ml-0 md:justify-self-end"
        aria-hidden="true"
      >
        &#8594;
      </span>
    </div>

    <div class="md:col-span-6 md:col-start-3 md:row-start-1">
      <h3 class="text-h3 text-ink decoration-1 underline-offset-4 group-hover:underline">
        {title}
      </h3>
      {description && <p class="text-small text-muted mt-1.5 max-w-text">{description}</p>}
      {tailMobile && <p class="meta mt-3 md:hidden">{tailMobile}</p>}
    </div>

    {tailDesktop && (
      <p class="meta hidden md:col-span-3 md:col-start-9 md:row-start-1 md:block">{tailDesktop}</p>
    )}
  </a>
</div>
