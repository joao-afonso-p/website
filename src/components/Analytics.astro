---
/**
 * GoatCounter visit counting. Cookie-free, so no consent banner. Rendered by
 * BaseLayout in production builds only; the site code is `goatcounterCode` in
 * `src/config/site.ts`.
 */
interface Props {
  code: string;
}

const { code } = Astro.props;
---

<script
  is:inline
  async
  data-goatcounter={`https://${code}.goatcounter.com/count`}
  src="https://gc.zgo.at/count.js"
></script>
