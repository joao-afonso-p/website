---
/**
 * Every <head> tag the site emits, in one place.
 *
 * Nothing here is invented: titles, descriptions and social links all come
 * from `src/config/site.ts`, and tags whose underlying asset does not exist
 * are omitted rather than pointed at a 404.
 */
import { existsSync } from 'node:fs';
import path from 'node:path';
import { site, social } from '../config/site';
import { absoluteUrl, appPath, canonicalUrl, url } from '../lib/paths';

interface Props {
  /** Page title, without the site suffix. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Share image path, relative to the site base. Must exist in `public/`. */
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedDate?: Date;
  updatedDate?: Date;
}

const {
  title,
  description = site.description,
  ogImage,
  type = 'website',
  noindex = false,
  publishedDate,
  updatedDate,
} = Astro.props;

/**
 * `appPath()` strips the deploy base that `Astro.url.pathname` already carries,
 * so canonicals never come out as `/base/base/page`.
 */
const isHome = appPath(Astro.url.pathname).replace(/\/$/, '') === '';
const pageTitle = title ? `${title} - ${site.name}` : `${site.name} - ${site.tagline}`;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);

/**
 * Checked on disk at build time rather than asserted: a card pointing at a
 * missing image renders worse than a card with no image, and a hand-maintained
 * boolean would silently lie if the file were ever removed.
 */
const OG_IMAGE_EXISTS = existsSync(path.join(process.cwd(), 'public', site.ogImage));
const shareImage: string | undefined = ogImage ?? (OG_IMAGE_EXISTS ? site.ogImage : undefined);
const shareImageUrl = shareImage ? absoluteUrl(shareImage, Astro.site) : undefined;

const personJsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      url: absoluteUrl('/', Astro.site),
      ...(social.length > 0 ? { sameAs: social.map((link) => link.href) } : {}),
    }
  : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
{/* A noindex page advertises no canonical: /404.html is served at /404, so a
    canonical of /404/ would point at a URL that does not exist. */}
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}

{/* Mirrors --color-paper so mobile browser chrome matches the page. */}
<meta name="theme-color" content="#f4f3ef" />

<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="sitemap" type="application/xml" href={url('/sitemap-index.xml')} />

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.ogLocale} />
{shareImageUrl && (
  <>
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:alt" content={`${site.name} - ${site.tagline}`} />
    {shareImage === site.ogImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
  </>
)}

{type === 'article' && publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{type === 'article' && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}

<meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}
{site.twitterHandle && <meta name="twitter:creator" content={site.twitterHandle} />}

{personJsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personJsonLd)}></script>
)}
