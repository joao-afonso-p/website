---
import { alfredoNav, nav } from '../../config/site';
import { url } from '../../lib/paths';

/**
 * What is actually on this site, listed on the masthead page.
 *
 * The first version of this was a compact index: a small mono label, a
 * sentence, an arrow, four hairline rows. It was correct and completely
 * inert, four grey labels doing nothing to make you want to open any of them.
 *
 * So the destination is the type now. Each row leads with the section name at
 * heading scale, the way every other page on the site leads with its heading,
 * and the sentence sits under it as a standfirst. The numeral on the left puts
 * the four of them in a sequence rather than a heap. Hovering lifts the whole
 * row onto the paper's sunk tone and pulls the rule across in the accent, so
 * the row reads as one target instead of a line of separate pieces.
 *
 * Still not cards: hairlines, a numeral, real type, one arrow. The weight
 * comes from the scale of the name, not from a box around it.
 *
 * Content comes from `nav` and `alfredoNav` in `src/config/site.ts`, hints
 * included, so renaming a section cannot leave two descriptions of it behind.
 */
interface Props {}

const destinations = [
  ...nav.map((item) => ({ ...item, accent: false, external: false })),
  { ...alfredoNav, accent: true, external: true },
];
---

<nav class="sections" aria-label="Sections">
  <ul>
    {destinations.map((item, index) => (
      <li>
        <a class="section" href={url(item.href)} data-accent={String(item.accent)}>
          <span class="section-index meta" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>

          <span class="section-body">
            <span class="section-name">{item.label}</span>
            <span class="section-hint">{item.hint}</span>
          </span>

          <span class="section-arrow" aria-hidden="true">
            <span class={item.external ? 'arrow-up' : 'arrow'}>{item.external ? '↗' : '→'}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .sections ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .section {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
    align-items: baseline;
    gap: 0 0.75rem;
    padding: 1.5rem 0;
    text-decoration: none;
    transition: background-color 220ms var(--ease-editorial);
  }

  /* The rule belongs to the row, drawn as a pseudo-element so it can take the
     accent on hover without the row's own background clipping it. */
  .section::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    border-top: 1px solid var(--color-rule);
    transition: border-color 220ms var(--ease-editorial);
  }

  .sections li:last-child .section::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .section-index {
    color: var(--color-faint);
    transition: color 220ms var(--ease-editorial);
  }

  .section-name {
    display: block;
    color: var(--color-ink);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: 500;
    transition: color 220ms var(--ease-editorial);
  }

  .section[data-accent='true'] .section-name {
    color: var(--color-accent);
  }

  .section-hint {
    display: block;
    margin-top: 0.5rem;
    max-width: var(--container-text);
    color: var(--color-muted);
    font-size: var(--text-body);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .section-arrow {
    justify-self: end;
    color: var(--color-faint);
    font-size: var(--text-h3);
    line-height: 1;
    transition: color 220ms var(--ease-editorial);
  }

  /* One hover state for the whole row. */
  .section:hover {
    background-color: var(--color-paper-sunk);
  }

  .section:hover::before {
    border-top-color: var(--color-accent);
  }

  .section:hover .section-index,
  .section:hover .section-arrow {
    color: var(--color-accent);
  }

  .section[data-accent='true']:hover .section-name {
    color: var(--color-accent-hover);
  }

  /* The background runs the full measure rather than stopping at the text. */
  @media (min-width: 768px) {
    .section {
      grid-template-columns: 3.5rem minmax(0, 1fr) 2rem;
      gap: 0 1.5rem;
      padding: 2rem 1rem 2.25rem;
      margin-inline: -1rem;
    }

    .section::before,
    .sections li:last-child .section::after {
      right: 1rem;
      left: 1rem;
    }
  }
</style>
