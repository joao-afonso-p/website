---
/**
 * The masthead of every page but the homepage. One `h1`, a lot of air.
 *
 * There used to be a mono rule above the heading carrying a section eyebrow on
 * the left and a count or date span on the right: `WORK  JAN 2017 - PRESENT`,
 * `BUILDS  04 ENTRIES`. It has gone. The eyebrow repeated the nav item you had
 * just clicked and the heading right below it, and the count was metadata about
 * the page rather than about the work. Between them they pushed the heading
 * most of the way down a phone screen to say nothing the page did not already.
 */
interface Props {
  title: string;
  lead?: string;
  note?: string;
}

const { title, lead, note } = Astro.props;
---

<header class="pt-14 pb-12 md:pt-section md:pb-20">
  <h1 class="text-h1 text-ink max-w-text">{title}</h1>

  {lead && <p class="text-lead text-ink-soft mt-6 max-w-text">{lead}</p>}
  {note && <p class="meta mt-8">{note}</p>}
</header>
