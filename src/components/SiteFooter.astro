---
import { site, social } from '../config/site';
import Container from './Container.astro';

/** No props: the footer is driven entirely by `src/config/site.ts`. */
interface Props {}

/** Minimal by design: a hairline, a name, the year, and wherever else I am. */
const year = new Date().getFullYear();
---

<footer class="mt-section">
  <Container>
    <div class="border-t border-rule py-10 md:py-12">
      <div class="flex flex-col gap-6 md:flex-row md:items-baseline md:justify-between md:gap-10">
        <div>
          <p class="text-ink">{site.wordmark}</p>
          <p class="meta mt-2">&copy; {year}</p>
        </div>

        {social.length > 0 && (
          <nav aria-label="Elsewhere">
            <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
              {social.map((link) => (
                <li>
                  <a
                    href={link.href}
                    rel="me noopener noreferrer"
                    target="_blank"
                    class="meta transition-colors hover:text-ink"
                  >
                    {link.label}{' '}
                    <span class="arrow-up" aria-hidden="true">
                      &#8599;
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>

      <p class="meta mt-10">Set in Schibsted Grotesk &amp; IBM Plex Mono. Built with Astro.</p>
    </div>
  </Container>
</footer>
