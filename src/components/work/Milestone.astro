---
/**
 * A target and what was delivered against it. Set at heading scale, not
 * display scale: it is evidence of a team's execution inside a longer story,
 * not a headline number.
 */
interface Props {
  target: string;
  targetUnit?: string;
  delivered: string;
  deliveredUnit?: string;
}

const { target, targetUnit, delivered, deliveredUnit } = Astro.props;
---

<dl class="work-milestone">
  <div class="work-milestone-cell">
    <dt class="work-milestone-label">Target</dt>
    <dd class="work-milestone-value">
      {target}
      {targetUnit && <span class="work-milestone-unit"> {targetUnit}</span>}
    </dd>
  </div>
  <div class="work-milestone-cell">
    <dt class="work-milestone-label">Delivered</dt>
    <dd class="work-milestone-value work-milestone-delivered">
      {delivered}
      {deliveredUnit && <span class="work-milestone-unit"> {deliveredUnit}</span>}
    </dd>
  </div>
</dl>

<style>
  .work-milestone {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 26rem;
    border-top: 1px solid var(--color-rule-strong);
    border-bottom: 1px solid var(--color-rule);
  }

  .work-milestone-cell {
    padding: 1rem 1rem 1.125rem 0;
  }

  .work-milestone-cell + .work-milestone-cell {
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-rule);
  }

  .work-milestone-label {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    letter-spacing: var(--text-meta--letter-spacing);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .work-milestone-value {
    margin: 0.75rem 0 0;
    color: var(--color-ink);
    font-size: var(--text-h2);
    line-height: 1;
    letter-spacing: var(--text-h2--letter-spacing);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .work-milestone-delivered {
    color: var(--color-accent);
  }

  .work-milestone-unit {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    line-height: 1.4;
    letter-spacing: var(--text-meta--letter-spacing);
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 400;
  }
</style>
