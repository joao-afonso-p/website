---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { EntryStatus } from '../content.config';
import { url } from '../lib/paths';
import StatusIndicator from './StatusIndicator.astro';

/**
 * The same row language as ProjectRow, given room to breathe: one highlighted
 * build, stacked rather than tabled, still typographic and still not a card.
 * Heading is an `h3` so it nests correctly under a SectionHeader `h2`; the
 * `text-h2` class carries the visual weight.
 */
interface Props {
  number?: string;
  title: string;
  oneLiner: string;
  description?: string;
  status?: EntryStatus;
  year?: number;
  tags?: string[];
  /** App-relative internal path. Resolved via `url()` here. */
  href?: string;
  /** Absolute external URL. Used only when `href` is absent. */
  externalUrl?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const {
  number,
  title,
  oneLiner,
  description,
  status,
  year,
  tags = [],
  href,
  externalUrl,
  cover,
  coverAlt,
} = Astro.props;

const isExternal = !href && Boolean(externalUrl);
const target = href ? url(href) : externalUrl;
const metaText = tags.length > 0 ? tags.join(' · ') : undefined;
const hasHeadRow = Boolean(number) || Boolean(status);
const hasMetaText = year !== undefined || Boolean(metaText);
const hasMetaRow = hasMetaText || Boolean(target);

const Root = target ? 'a' : 'div';
---

<article class="border-t border-rule">
  <Root
    href={target}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    class:list={['group block py-10 transition-colors md:py-14', target && 'hover:bg-paper-sunk']}
  >
    {hasHeadRow && (
      <div class="flex items-baseline gap-4">
        {number && <span class="meta text-muted tabular-nums">{number}</span>}
        <StatusIndicator status={status} class="ml-auto" />
      </div>
    )}

    <h3
      class:list={[
        'text-h2 text-ink max-w-text decoration-1 underline-offset-4 group-hover:underline',
        hasHeadRow && 'mt-6',
      ]}
    >
      {title}
    </h3>

    <p class="text-lead text-ink-soft mt-4 max-w-text">{oneLiner}</p>

    {description && <p class="text-small text-muted mt-5 max-w-text">{description}</p>}

    {hasMetaRow && (
      <div class="mt-8 flex items-baseline justify-between gap-6 border-t border-rule pt-4">
        {hasMetaText && (
          <p class="meta">
            {year !== undefined && <time datetime={String(year)}>{year}</time>}
            {year !== undefined && metaText && <span aria-hidden="true"> &#183; </span>}
            {metaText}
          </p>
        )}

        {target && (
          <span class="meta text-accent ml-auto shrink-0 whitespace-nowrap">
            {isExternal ? 'Visit' : 'Read the build'}{' '}
            <span class={isExternal ? 'arrow-up' : 'arrow'} aria-hidden="true">
              {isExternal ? '↗' : '→'}
            </span>
          </span>
        )}
      </div>
    )}

    {cover && (
      <Image
        src={cover}
        alt={coverAlt ?? ''}
        widths={[640, 960, 1280]}
        sizes="(min-width: 768px) 68rem, 100vw"
        loading="lazy"
        decoding="async"
        class="mt-10 w-full border border-rule"
      />
    )}
  </Root>
</article>
