---
import { url } from '../lib/paths';

/**
 * A numbered section label sitting on a hairline, with an optional index link.
 * Renders an `h2` at meta scale — section titles are labels, not headlines.
 */
interface Props {
  /** Mono section index, e.g. `02`. Decorative. */
  index?: string;
  title: string;
  description?: string;
  /** App-relative path, e.g. `/builds`. Resolved through `url()` here. */
  href?: string;
  linkLabel?: string;
  /** Set when the consumer wants `aria-labelledby` on the surrounding section. */
  id?: string;
}

const { index, title, description, href, linkLabel = 'All', id } = Astro.props;
---

<header class="border-t border-rule pt-4">
  <div class="flex items-baseline justify-between gap-6">
    <h2 id={id} class="meta text-ink flex items-baseline gap-3">
      {index && (
        <span class="text-muted" aria-hidden="true">
          {index}
        </span>
      )}
      <span>{title}</span>
    </h2>

    {href && (
      <a
        href={url(href)}
        class="meta text-accent group shrink-0 whitespace-nowrap transition-colors hover:text-accent-hover"
      >
        {linkLabel}{' '}
        <span class="arrow" aria-hidden="true">
          &#8594;
        </span>
      </a>
    )}
  </div>

  {description && <p class="text-small text-muted mt-3 max-w-text">{description}</p>}
</header>
