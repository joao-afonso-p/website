---
/**
 * A numbered editorial point: the same index-table language the listings use:
 * mono numeral, hairline, heading, then prose. Not a card.
 */
interface Props {
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<section class="numbered">
  <p class="numbered-index" aria-hidden="true">
    {number}
  </p>

  <div class="numbered-body">
    <h3 class="numbered-title">{title}</h3>
    <div class="numbered-prose">
      <slot />
    </div>
  </div>
</section>

<style>
  .numbered {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
  }

  .numbered + :global(.numbered) {
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .numbered {
      grid-template-columns: 4.5rem 1fr;
      padding-top: 1.5rem;
    }

    .numbered + :global(.numbered) {
      margin-top: 2.5rem;
    }
  }

  .numbered-index {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--text-meta--letter-spacing);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .numbered-title {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    letter-spacing: var(--text-h3--letter-spacing);
    font-weight: 500;
  }

  .numbered-prose {
    margin-top: 0.75rem;
    color: var(--color-ink-soft);
  }

  .numbered-prose :global(p) {
    margin: 0;
  }

  .numbered-prose :global(p + p) {
    margin-top: 0.75rem;
  }
</style>
