---
import type { EntryStatus } from '../content.config';
import { url } from '../lib/paths';
import StatusIndicator from './StatusIndicator.astro';

/**
 * The editorial table row. NOT a card.
 *
 * Desktop (>=768px) is a 12-column index table:
 *   NO. | TITLE + description | meta / tags | STATUS | arrow
 * Every cell is placed with an explicit `col-start`, so DOM order is free to
 * follow the mobile reading order instead of the visual column order.
 *
 * Mobile reorganises rather than shrinks: the number, status and arrow collapse
 * into one compact mono row, then the title, then the description, then the
 * metadata. `md:contents` dissolves that mono row's wrapper on desktop so its
 * three children drop straight into the table grid.
 *
 * Hairlines only: `border-t` on every row, `last:border-b` closes the list, so
 * render rows as direct siblings (do not wrap each one in its own `<li>`).
 */
interface Props {
  /** Mono index, e.g. `01`. Decorative. */
  number?: string;
  title: string;
  description?: string;
  status?: EntryStatus;
  /** Overrides the uppercased status word. */
  statusLabel?: string;
  year?: number;
  tags?: string[];
  /** App-relative internal path, e.g. `/builds/contas`. Resolved via `url()` here. */
  href?: string;
  /** Absolute external URL. Used only when `href` is absent. */
  externalUrl?: string;
  /** Replaces the joined `tags` in the metadata column. */
  meta?: string;
}

const {
  number,
  title,
  description,
  status,
  statusLabel,
  year,
  tags = [],
  href,
  externalUrl,
  meta,
} = Astro.props;

const isExternal = !href && Boolean(externalUrl);
const target = href ? url(href) : externalUrl;
const metaText = meta ?? (tags.length > 0 ? tags.join(' · ') : undefined);
const hasMetaCell = year !== undefined || Boolean(metaText);

const Row = target ? 'a' : 'div';
---

<div class="border-t border-rule last:border-b">
  <Row
    href={target}
    target={isExternal ? '_blank' : undefined}
    rel={isExternal ? 'noopener noreferrer' : undefined}
    class:list={[
      'group grid grid-cols-1 gap-x-6 gap-y-2 py-5 transition-colors',
      'md:grid-cols-12 md:items-baseline md:gap-y-0 md:py-6',
      target && 'hover:bg-paper-sunk',
    ]}
  >
    {/* Mobile: one compact mono row. Desktop: three separate table cells. */}
    <div class="flex items-baseline gap-4 md:contents">
      {number && (
        <span class="meta text-muted tabular-nums md:col-span-1 md:col-start-1 md:row-start-1">
          {number}
        </span>
      )}

      <StatusIndicator
        status={status}
        label={statusLabel}
        class="md:col-span-2 md:col-start-10 md:row-start-1"
      />

      <span
        class:list={[
          'meta text-muted ml-auto md:col-span-1 md:col-start-12 md:row-start-1 md:ml-0 md:justify-self-end',
          isExternal ? 'arrow-up' : 'arrow',
        ]}
        aria-hidden="true"
      >
        {isExternal ? '↗' : '→'}
      </span>
    </div>

    <div class="md:col-span-5 md:col-start-2 md:row-start-1">
      <h3 class="text-h3 text-ink decoration-1 underline-offset-4 group-hover:underline">
        {title}
      </h3>
      {description && <p class="text-small text-muted mt-1.5 max-w-text">{description}</p>}
    </div>

    {hasMetaCell && (
      <p class="meta md:col-span-3 md:col-start-7 md:row-start-1">
        {year !== undefined && <time datetime={String(year)}>{year}</time>}
        {year !== undefined && metaText && <span aria-hidden="true"> &#183; </span>}
        {metaText}
      </p>
    )}
  </Row>
</div>
