---
import Container from '../components/Container.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';

/**
 * The gateway to the long project.
 *
 * It has to read as the same design universe while clearly being its own thing,
 * and it earns that with exactly one structural move: the masthead is a
 * full-bleed `bg-paper-sunk` band and the wordmark is set at `text-display` —
 * the only place outside the homepage hero that reaches for that size. No new
 * colours, no new fonts, no new components.
 *
 * Everything factual is a `TODO:`. This page will later link to, or grow into,
 * a dedicated Alfredo site, so it stays structurally simple on purpose.
 */
const sections = [
  {
    id: 'what',
    index: '01',
    title: 'What it is',
    body: 'TODO: describe Alfredo plainly — what it actually is today, in two or three sentences, with no promises about what it will become.',
  },
  {
    id: 'why',
    index: '02',
    title: 'Why it exists',
    body: 'TODO: the real reason this project started, and why a personal operating system is the shape the answer took.',
  },
  {
    id: 'where',
    index: '03',
    title: 'Where it lives',
    body: 'TODO: link to the dedicated Alfredo site once it exists. Until then, this page is the whole of it.',
  },
] as const;
---

<BaseLayout
  title="Alfredo"
  description="The long project: building a personal operating system around my actual life."
>
  <section class="bg-paper-sunk border-b border-rule" aria-labelledby="alfredo">
    <Container>
      <div class="pt-14 pb-16 md:pt-section md:pb-24">
        <p class="meta border-b border-rule-strong pb-4">The long project</p>

        <h1 id="alfredo" class="text-display text-ink mt-10 md:mt-14">
          Alfredo
        </h1>

        <p class="text-lead text-ink-soft mt-10 max-w-text md:mt-14">
          Building a personal operating system around my actual life.
        </p>
      </div>
    </Container>
  </section>

  <Container>
    <div class="pt-14 md:pt-20">
      {sections.map((section) => (
        <section aria-labelledby={section.id} class="pb-14 md:pb-20">
          <SectionHeader id={section.id} index={section.index} title={section.title} />

          <div class="mt-8 md:mt-10 md:grid md:grid-cols-12 md:gap-x-6">
            <div class="md:col-span-7 md:col-start-2">
              <p class="meta text-muted">To write</p>
              <p class="text-body text-muted mt-3 max-w-prose">{section.body}</p>
            </div>
          </div>
        </section>
      ))}

      <div class="border-t border-rule pt-6">
        <a
          href={url('/')}
          class="meta text-accent inline-flex items-baseline gap-2 transition-colors hover:text-accent-hover"
        >
          <span aria-hidden="true">&#8592;</span> Back to the rest of the site
        </a>
      </div>
    </div>
  </Container>
</BaseLayout>
