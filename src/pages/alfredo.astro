---
import CapabilityTable from '../components/alfredo/CapabilityTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';

/**
 * The long project.
 *
 * Alfredo gets its own surface: a cooler, lighter paper, a brighter blue, its
 * own 1160px measure and a tighter type scale than the rest of the site. The
 * site's typefaces and its editorial index-table language carry over, so the
 * page still reads as part of the same universe while being unmistakably its
 * own thing. The full-bleed background is what makes the narrower measure read
 * as deliberate rather than misaligned.
 *
 * Content lives in `src/config/alfredo.ts`.
 */
---

<BaseLayout
  title="Alfredo"
  description="A record of what Alfredo knows: a personal operating system, one capability at a time."
>
  <div class="alfredo-surface">
    <div class="alfredo-page">
      <header class="alfredo-hero">
        <div>
          <p class="alfredo-kicker">A personal operating system · One capability at a time</p>

          <h1>A record of what Alfredo knows.</h1>
        </div>

        <div class="alfredo-introduction">
          <strong>Meet Alfredo.</strong>
          An AI agent I’m building to understand the context of my life, remember what matters, and
          help at the right moment—without taking control away from me.
        </div>
      </header>

      <CapabilityTable />

      <div class="alfredo-back">
        <a href={url('/')}>
          <span aria-hidden="true">&#8592;</span> Back to the rest of the site
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Full-bleed so Alfredo's paper, not the site's, is the page surface. */
  .alfredo-surface {
    background: var(--color-alfredo-bg);
    color: var(--color-alfredo-text);
  }

  .alfredo-page {
    max-width: 1160px;
    margin: 0 auto;
    padding: 22px 30px 44px;
  }

  .alfredo-hero {
    display: grid;
    grid-template-columns: 2.3fr 1fr;
    gap: 60px;
    align-items: end;
    padding: 60px 0 58px;
  }

  .alfredo-kicker {
    margin: 0 0 22px;
    color: var(--color-alfredo-blue);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .alfredo-hero h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(46px, 8vw, 92px);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.07em;
  }

  .alfredo-introduction {
    max-width: 270px;
    color: var(--color-alfredo-muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .alfredo-introduction strong {
    display: block;
    margin-bottom: 12px;
    color: var(--color-alfredo-text);
    font-weight: 500;
  }

  .alfredo-back {
    padding-top: 28px;
  }

  .alfredo-back a {
    color: var(--color-alfredo-blue);
    font-family: var(--font-mono);
    font-size: 9px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .alfredo-back a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .alfredo-page {
      padding: 18px 14px 34px;
    }

    .alfredo-hero {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 45px 0 40px;
    }
  }
</style>
