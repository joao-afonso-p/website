---
import CapabilityMap from '../components/alfredo/CapabilityMap.astro';
import Container from '../components/Container.astro';
import { alfredoCopy, alfredoMeta } from '../config/alfredo';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths';

/**
 * The long project.
 *
 * Alfredo used to sit on its own paper, with its own palette and its own
 * measure. It no longer does: same warm background, same near-black ink, same
 * blue, same type scale, same container as every other page. What makes it
 * feel like its own thing now is the capability map, not a different surface,
 * which is the right way round for the one page that has a real object on it.
 *
 * Three areas and no more: the masthead, the map, and one closing statement.
 * The map replaced an accordion that listed the same capabilities underneath
 * it; nothing repeats the map's content anywhere on the page.
 *
 * The masthead is now kicker, heading, intro and nothing else. The mono rule
 * that used to sit above it, carrying the standing facts and a small "follow"
 * link, has gone the same way as the eyebrow rules on the other pages: it
 * pushed the heading down most of a phone screen to say very little, and the
 * page already ends on a proper call to action pointing at the same place.
 *
 * All copy lives in `src/config/alfredo.ts`, including the "follow" URL, which
 * still renders the closing link only when it is set.
 */
const { followUrl } = alfredoMeta;
---

<BaseLayout title="Alfredo" description={alfredoCopy.metaDescription}>
  <Container>
    <header class="pt-14 pb-12 md:pt-section md:pb-16">
      <p class="meta text-accent">{alfredoCopy.kicker}</p>

      <h1 class="text-h1 text-ink mt-6 max-w-text md:mt-7">{alfredoCopy.heading}</h1>

      <p class="text-lead text-ink-soft mt-10 max-w-text md:mt-12">{alfredoCopy.intro}</p>
    </header>

    <CapabilityMap />

    <section class="mt-section md:mt-section-lg" aria-labelledby="alfredo-toward">
      <div class="border-t border-rule pt-8 md:pt-10">
        <h2 class="text-h2 text-ink max-w-text" id="alfredo-toward">
          {alfredoCopy.closingHeading}
        </h2>

        <p class="text-lead text-ink-soft mt-7 max-w-text">{alfredoCopy.closingLead}</p>

        {/* The one real call to action on the page. An editorial text link at
            heading scale, the same treatment a build's "Visit" link gets, since
            the site has no buttons. It shares `followUrl` with the small link
            in the metadata line, so there is one URL to change. */}
        {followUrl && (
          <div class="mt-10 md:mt-12">
            <a
              class="text-accent hover:text-accent-hover text-h3 group inline-flex items-baseline gap-2 underline decoration-1 underline-offset-4 transition-colors hover:decoration-2"
              href={followUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {alfredoCopy.ctaLabel}
              <span class="arrow-up" aria-hidden="true">
                &#8599;
              </span>
            </a>

            <p class="meta mt-3">{alfredoCopy.ctaNote}</p>
          </div>
        )}
      </div>
    </section>

    <p class="mt-14 md:mt-20">
      <a class="meta text-accent hover:text-accent-hover group transition-colors" href={url('/')}>
        <span class="arrow-back" aria-hidden="true">
          &#8592;
        </span>{' '}
        {alfredoCopy.backLabel}
      </a>
    </p>
  </Container>
</BaseLayout>

<style>
  /* The site's `.arrow` eases forward; a "back to" link should ease the other
     way. Local to this page, which is the only place one is used. */
  .arrow-back {
    display: inline-block;
    transition: transform 220ms var(--ease-editorial);
  }

  a:hover > .arrow-back {
    transform: translateX(-0.25em);
  }
</style>
