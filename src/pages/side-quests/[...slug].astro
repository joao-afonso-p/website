---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Container from '../../components/Container.astro';
import Prose from '../../components/Prose.astro';
import StatusIndicator from '../../components/StatusIndicator.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSideQuests, pageDescription, sideQuestStatusLabel } from '../../lib/content';
import { site } from '../../config/site';
import { url } from '../../lib/paths';

/**
 * A side quest.
 *
 * Same furniture as /builds/[slug] (an eyebrow row on a hairline, mono
 * metadata, the headline, the lead, the body at reading measure, a quiet
 * footer), with one difference. A build's metadata is a specification (stack,
 * tags, last updated), so it is set as a `<dl>` of labelled pairs. A side
 * quest's metadata is a single fact about when and in what capacity, so it is
 * one mono line: `2021 · SHARKCODERS`, `2024 - NOW · CO-FOUNDER & CEO`.
 *
 * The bodies are MDX and deliberately unequal in length. Six months of teaching
 * gets a short page and four years of building a company gets a long one; the
 * template imposes no structure beyond the reading measure, so each story can
 * be as long as it has substance for.
 *
 * Paths and prev/next come from `getSideQuests()`, so the reading order is the
 * chronology of /side-quests, newest first, and drafts stay out of the built
 * site. `prev` is therefore the *later* side quest and `next` the earlier one,
 * which is why the labels below read Later/Earlier rather than Previous/Next.
 */
export async function getStaticPaths() {
  const sideQuests = await getSideQuests();

  return sideQuests.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: sideQuests[index - 1] ?? undefined,
      next: sideQuests[index + 1] ?? undefined,
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, prev, next } = Astro.props as Props;
const { Content } = await render(entry);

const { data } = entry;
const lead = data.intro ?? data.description ?? data.oneLiner;
const metaDescription = pageDescription(
  [data.description, data.intro, data.oneLiner],
  `${data.title}, a side quest of ${site.name}.`,
);

/**
 * The eyebrow names the thing and the `h1` says something about it, so an entry
 * with a `headline` puts its own name up top. Without one the `h1` is already
 * the name and the eyebrow falls back to the collection label.
 */
const eyebrow = data.headline ? data.title : 'Side quest';
const heading = data.headline ?? data.title;

/** `period` is the human string; `year` only stands in when there is no period. */
const period = data.period ?? (data.year === undefined ? undefined : String(data.year));

/**
 * When, where, in what capacity, in that order, uppercased by `.meta`. Every
 * part is optional, so the line shortens rather than breaking, and disappears
 * entirely if an entry carries none of them.
 */
const metaLine = [period, data.org, data.role, ...data.tags]
  .filter((part): part is string => Boolean(part))
  .join(' · ');
---

<BaseLayout title={data.title} description={metaDescription}>
  <Container>
    {/* The reading measure is left-aligned inside the page frame, so
        every page on the site shares one left edge. */}
    <article class="max-w-text">
      <header class="pt-14 pb-12 md:pt-section md:pb-16">
        <div class="flex items-baseline justify-between gap-6 border-b border-rule pb-4">
          <p class="meta">{eyebrow}</p>
          <StatusIndicator
            status={data.status}
            label={sideQuestStatusLabel(data.status)}
            class="ml-auto shrink-0"
          />
        </div>

        {metaLine !== '' && <p class="meta mt-6">{metaLine}</p>}

        <h1 class="text-h1 text-ink mt-8 md:mt-10">{heading}</h1>
        <p class="text-lead text-ink-soft mt-6">{lead}</p>

        {/* An editorial text link, not a button: the site has no buttons. */}
        {data.url && (
          <p class="mt-8 md:mt-10">
            <a
              href={data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:text-accent-hover text-h3 group inline-flex items-baseline gap-2 underline decoration-1 underline-offset-4 transition-colors hover:decoration-2"
            >
              {data.cta ?? `Visit ${data.title}`}
              <span class="arrow-up" aria-hidden="true">
                &#8599;
              </span>
            </a>
          </p>
        )}
      </header>

      <Prose>
        <Content />
      </Prose>

      <footer class="mt-20 border-t border-rule pt-6 md:mt-24">
        <a
          href={url('/side-quests')}
          class="meta text-accent inline-flex items-baseline gap-2 transition-colors hover:text-accent-hover"
        >
          <span aria-hidden="true">&#8592;</span> All side quests
        </a>

        {(prev || next) && (
          <nav
            aria-label="Other side quests"
            class="mt-10 grid gap-8 border-t border-rule pt-8 md:grid-cols-2 md:gap-12"
          >
            {prev ? (
              <a href={url(`/side-quests/${prev.id}`)} class="group block">
                <span class="meta text-muted">Later</span>
                <span class="text-h3 text-ink mt-2 block decoration-1 underline-offset-4 group-hover:underline">
                  {prev.data.title}
                </span>
              </a>
            ) : (
              <div class="hidden md:block" />
            )}

            {next && (
              <a href={url(`/side-quests/${next.id}`)} class="group block md:text-right">
                <span class="meta text-muted">Earlier</span>
                <span class="text-h3 text-ink mt-2 block decoration-1 underline-offset-4 group-hover:underline">
                  {next.data.title}
                </span>
              </a>
            )}
          </nav>
        )}
      </footer>
    </article>
  </Container>
</BaseLayout>
