---
import Container from '../../components/Container.astro';
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import QuestEntry from '../../components/quest/QuestEntry.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSideQuests, sideQuestStatusLabel } from '../../lib/content';

/**
 * The side quests index: a chronology, not an index table.
 *
 * /builds and /work are ranked lists of comparable things, so they share
 * `ProjectRow`. These five are not comparable: six months of teaching and four
 * years of building a company do not belong in the same table cell. What they
 * have in common is a sequence, so the page is built on the year instead of on
 * a row number, and `getSideQuests()` returns them newest first.
 *
 * `featured` marks the entry that outgrew the others and gives it more room.
 * It is emphasis, not a pinned position: the order stays chronological.
 */
const sideQuests = await getSideQuests();

/** Falls back to the sortable year so an entry without a label still dates itself. */
const label = (entry: (typeof sideQuests)[number]): string =>
  entry.data.yearLabel ?? (entry.data.year === undefined ? '' : String(entry.data.year));

/**
 * `<time datetime>` only when the label really is a single year: a range or a
 * `2024 - Now` is not a valid datetime, and claiming otherwise in the markup
 * is worse than leaving the label as plain text.
 */
const datetime = (value: string): string | undefined =>
  /^\d{4}$/.test(value.trim()) ? value.trim() : undefined;
---

<BaseLayout
  title="Side Quests"
  description="Work that wasn’t quite a job and wasn’t quite a weekend project: teaching, competitions, prototypes and companies built outside a main job."
>
  <Container>
    <PageIntro
      title="Work that wasn’t quite a job and wasn’t quite a weekend project."
      lead="Teaching, competitions, prototypes, companies and a few things that became much more serious than I expected."
    />

    {/* Structural only: the entries render h3, so the page needs an h2 between
        them and the h1. No visible label is wanted here. */}
    <h2 class="sr-only">All side quests, most recent first</h2>

    {sideQuests.length > 0 ? (
      <div>
        {sideQuests.map((entry) => {
          const year = label(entry);
          return (
            <QuestEntry
              year={year}
              datetime={datetime(year)}
              title={entry.data.title}
              description={entry.data.description ?? entry.data.oneLiner}
              marker={entry.data.marker}
              status={entry.data.status}
              statusLabel={sideQuestStatusLabel(entry.data.status)}
              href={`/side-quests/${entry.id}`}
              emphasis={entry.data.featured}
            />
          );
        })}
      </div>
    ) : (
      <EmptyState message="These are the hardest ones to write honestly, so they go up one at a time and only once the account of them is accurate." />
    )}
  </Container>
</BaseLayout>
