---
import Container from '../../components/Container.astro';
import EmptyState from '../../components/EmptyState.astro';
import PageIntro from '../../components/PageIntro.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import Talks from '../../components/notes/Talks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getNotes } from '../../lib/content';
import { url } from '../../lib/paths';

/**
 * Notes: the writing, plus a record of talks.
 *
 * The page is the publishing foundation, so it has to read as intentional with
 * zero articles published: a clear lead, a plainly stated "nothing yet" for the
 * writing, and the Talks section carrying real content underneath. The articles
 * list reuses `ProjectRow` so a note takes the same editorial row as a build or
 * a role, with its publication date in the metadata column.
 *
 * The RSS link only appears once there is something to subscribe to; the feed
 * itself is always discoverable from the `<head>` (see `Seo.astro`).
 */
const notes = await getNotes();
---

<BaseLayout
  title="Notes"
  description="Occasional writing on what I’m building and figuring out, and a record of the talks I’ve given."
>
  <Container>
    <PageIntro
      title="Notes."
      lead="Writing on what I’m building and figuring out, and a record of the talks I’ve given."
    />

    {/* Structural: the rows render h3, so the writing list needs an h2 above
        them. The Talks section provides its own visible h2 below. */}
    <h2 class="sr-only">Writing</h2>

    {notes.length > 0 ? (
      <div>
        {notes.map((entry, index) => (
          <ProjectRow
            number={String(index + 1).padStart(2, '0')}
            title={entry.data.title}
            description={entry.data.summary}
            meta={formatDate(entry.data.date)}
            href={`/notes/${entry.id}`}
          />
        ))}
      </div>
    ) : (
      <EmptyState message="The first notes are being written. They go up here when the writing is done, not when the work is." />
    )}

    {notes.length > 0 && (
      <p class="mt-8">
        <a href={url('/notes/rss.xml')} class="meta link inline-flex items-baseline gap-2">
          RSS feed
          <span class="arrow-up" aria-hidden="true">
            &#8599;
          </span>
        </a>
      </p>
    )}

    <Talks class="mt-section md:mt-section-lg" />
  </Container>
</BaseLayout>
