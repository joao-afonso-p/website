---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Container from '../../components/Container.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import Prose from '../../components/Prose.astro';
import StatusIndicator from '../../components/StatusIndicator.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getBuilds, pageDescription } from '../../lib/content';
import { site } from '../../config/site';
import { url } from '../../lib/paths';

/**
 * A build.
 *
 * Deliberately under-designed: real content arrives later and each page will be
 * designed properly then. What this template guarantees is a foundation that
 * cannot break: every frontmatter field is optional, and a missing one simply
 * vanishes, whether that is the metadata block or the status marker.
 *
 * Paths and prev/next come from `getBuilds()`, so the reading order here is the
 * same order as /builds and drafts stay out of the built site.
 */
export async function getStaticPaths() {
  const builds = await getBuilds();

  return builds.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: builds[index - 1] ?? undefined,
      next: builds[index + 1] ?? undefined,
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, prev, next } = Astro.props as Props;
const { Content } = await render(entry);

const { data } = entry;
const lead = data.description ?? data.oneLiner;
const metaDescription = pageDescription(
  [data.description, data.oneLiner],
  `${data.title}, a build by ${site.name}.`,
);

const list = (values: string[] | undefined): string | undefined =>
  values && values.length > 0 ? values.join(' · ') : undefined;

/**
 * The eyebrow names the thing and the `h1` says something about it, so a build
 * with a `headline` puts its own name up top. Without one the `h1` is already
 * the name, and repeating it would be noise, hence the collection label.
 */
const eyebrow = data.headline ? data.title : 'Build';
const heading = data.headline ?? data.title;

/**
 * Status and year share the eyebrow rule, so neither is repeated below it.
 * `since` replaces the bare year when a build would rather date its start
 * ("Since Jul 2026") than name a year; the machine-readable `datetime` stays
 * the year either way.
 */
const eyebrowYear = data.year === undefined ? undefined : String(data.year);
const eyebrowDate = data.since ?? eyebrowYear;
---

<BaseLayout title={data.title} description={metaDescription}>
  <Container>
    {/* The reading measure is left-aligned inside the page frame, so
        every page on the site shares one left edge. */}
    <article class="max-w-text">
      <header class="pt-14 pb-12 md:pt-section md:pb-16">
        <div class="flex items-baseline justify-between gap-6 border-b border-rule pb-4">
          <p class="meta">{eyebrow}</p>

          <p class="meta ml-auto flex shrink-0 items-baseline gap-2">
            <StatusIndicator status={data.status} />
            {data.status && eyebrowDate && <span aria-hidden="true">&#183;</span>}
            {eyebrowDate && <time datetime={eyebrowYear}>{eyebrowDate}</time>}
          </p>
        </div>

        <EntryMeta
          class="mt-8 md:mt-10"
          items={[
            { label: 'Stack', value: list(data.stack) },
            { label: 'Tags', value: list(data.tags) },
            { label: 'Updated', value: data.updated ? formatDate(data.updated) : undefined },
          ]}
          links={[{ label: 'Source', href: data.repo }]}
        />

        <h1 class="text-h1 text-ink mt-10 md:mt-12">{heading}</h1>
        <p class="text-lead text-ink-soft mt-6">{lead}</p>

        {data.role && <p class="meta text-muted mt-8">{data.role}</p>}

        {/* An editorial text link, not a button: the site has no buttons. */}
        {data.url && (
          <p class="mt-8 md:mt-10">
            <a
              href={data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:text-accent-hover text-h3 group inline-flex items-baseline gap-2 underline decoration-1 underline-offset-4 transition-colors hover:decoration-2"
            >
              {data.cta ?? `Visit ${data.title}`}
              <span class="arrow-up" aria-hidden="true">
                &#8599;
              </span>
            </a>
          </p>
        )}
      </header>

      {/* No cover here: `cover` is the /builds index thumbnail. The page goes
          straight to the text, and the case study places its own figures. */}
      <Prose>
        <Content />
      </Prose>

      <footer class="mt-20 border-t border-rule pt-6 md:mt-24">
        <a
          href={url('/builds')}
          class="meta text-accent inline-flex items-baseline gap-2 transition-colors hover:text-accent-hover"
        >
          <span aria-hidden="true">&#8592;</span> All builds
        </a>

        {(prev || next) && (
          <nav
            aria-label="Other builds"
            class="mt-10 grid gap-8 border-t border-rule pt-8 md:grid-cols-2 md:gap-12"
          >
            {prev ? (
              <a href={url(`/builds/${prev.id}`)} class="group block">
                <span class="meta text-muted">Previous</span>
                <span class="text-h3 text-ink mt-2 block decoration-1 underline-offset-4 group-hover:underline">
                  {prev.data.title}
                </span>
              </a>
            ) : (
              <div class="hidden md:block" />
            )}

            {next && (
              <a href={url(`/builds/${next.id}`)} class="group block md:text-right">
                <span class="meta text-muted">Next</span>
                <span class="text-h3 text-ink mt-2 block decoration-1 underline-offset-4 group-hover:underline">
                  {next.data.title}
                </span>
              </a>
            )}
          </nav>
        )}
      </footer>
    </article>
  </Container>
</BaseLayout>
