---
import Currently from '../components/home/Currently.astro';
import Hero from '../components/home/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * The homepage: a masthead and one line about now. Nothing else.
 *
 * It states the premise and gets out of the way — the work itself lives behind
 * the nav, so previewing it here would only say the same thing twice. Currently
 * sits tight under the hero (`mt-10`) because it belongs to the masthead rather
 * than being a section of its own.
 *
 * No `title` prop: BaseLayout emits the bare branded title. No `description`
 * either — `site.description` is already the best sentence available about what
 * this site is.
 *
 * `BaseLayout` is a `min-h-dvh` flex column with `flex-1` on `<main>`, so on a
 * page this short the footer settles at the bottom of the viewport instead of
 * floating halfway up it.
 */
---

<BaseLayout>
  <Hero />
  <Currently />
</BaseLayout>
