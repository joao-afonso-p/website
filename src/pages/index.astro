---
import Container from '../components/Container.astro';
import Currently from '../components/home/Currently.astro';
import Hero from '../components/home/Hero.astro';
import Sections from '../components/home/Sections.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

/**
 * The homepage: a masthead, one line about now, and the way in.
 *
 * It used to be the masthead alone, on the reasoning that the work lived
 * behind the nav and previewing it here would say the same thing twice. That
 * reasoning depended on the nav being permanently visible, which it no longer
 * is below 768px: the header collapses to a menu there, and a masthead with no
 * visible route onward is a dead end. So the four destinations are listed
 * here, with a line each, which is something the header could never afford.
 *
 * `Currently` is still not a section of the page; it is an annotation on the
 * masthead, so it goes into the hero's `annotation` slot and shares the
 * masthead's grid rather than opening a band of its own below it.
 *
 * No `title` prop: BaseLayout emits the bare branded title. No `description`
 * either: `site.description` is already the best sentence available about what
 * this site is.
 */
---

<BaseLayout>
  <Hero>
    <Currently slot="annotation" />
  </Hero>

  <section class="mt-16 md:mt-24" aria-labelledby="home-sections">
    <Container>
      <h2 class="sr-only" id="home-sections">
        Sections
      </h2>
      <Sections />
    </Container>
  </section>
</BaseLayout>
