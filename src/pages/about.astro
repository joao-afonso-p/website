---
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeader from '../components/SectionHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { social } from '../config/site';

/**
 * Structure only.
 *
 * Nothing here states a fact about João Afonso that was not given: the one
 * framing idea below is his own line, and every body block is an explicit
 * `TODO:` for him to replace. The page is laid out as a finished page whose
 * text is pending — labelled sections, real rules, real rhythm — so that
 * filling it in is an edit rather than a redesign.
 *
 * Section bodies are indented into the second column of the same twelve-column
 * grid the index tables use, so /about sits in the same system as /builds.
 */
const sections = [
  {
    id: 'who',
    index: '01',
    title: 'Who I am',
    body: 'TODO: a few sentences in the first person. Who you are and what you do, without a job title doing the work for you.',
  },
  {
    id: 'work',
    index: '02',
    title: 'What I work on',
    body: 'TODO: the kind of problems you spend your days on, and the kind you spend your evenings on. Name the through-line between them.',
  },
  {
    id: 'residue',
    index: '03',
    title: 'What the résumé leaves out',
    body: 'TODO: the parts a bullet point flattens — the attempt that failed, the argument you lost, the unglamorous work that mattered, the taste you developed along the way.',
  },
  {
    id: 'building',
    index: '04',
    title: 'How I think about building',
    body: 'TODO: what you believe about making things, stated plainly enough that someone could disagree with it.',
  },
] as const;
---

<BaseLayout
  title="About"
  description="The résumé is the compressed version. This website is the version that doesn’t fit in a résumé."
>
  <Container>
    <PageIntro
      eyebrow="About"
      title="My résumé is the compressed version."
      lead="This website is the version that doesn’t fit in a résumé."
    />

    {sections.map((section) => (
      <section aria-labelledby={section.id} class="pb-14 md:pb-20">
        <SectionHeader id={section.id} index={section.index} title={section.title} />

        <div class="mt-8 md:mt-10 md:grid md:grid-cols-12 md:gap-x-6">
          <div class="md:col-span-7 md:col-start-2">
            <p class="meta text-muted">To write</p>
            <p class="text-body text-muted mt-3 max-w-prose">{section.body}</p>
          </div>
        </div>
      </section>
    ))}

    <section aria-labelledby="elsewhere" class="pb-4">
      <SectionHeader id="elsewhere" index="05" title="Elsewhere" />

      <div class="mt-8 md:mt-10 md:grid md:grid-cols-12 md:gap-x-6">
        <div class="md:col-span-7 md:col-start-2">
          {social.length > 0 && (
            <ul class="space-y-3">
              {social.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="me noopener noreferrer"
                    class="link text-body"
                  >
                    {link.label}{' '}
                    <span class="arrow-up" aria-hidden="true">
                      &#8599;
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          <p class="meta text-muted mt-8">To write</p>
          <p class="text-body text-muted mt-3 max-w-prose">
            TODO: add the remaining channels — email, LinkedIn, anything else worth publishing — to{' '}
            <code class="font-mono text-small">social</code> in{' '}
            <code class="font-mono text-small">src/config/site.ts</code>. An empty entry is simply
            not rendered, so nothing here breaks while the list is short.
          </p>
        </div>
      </div>
    </section>
  </Container>
</BaseLayout>
